{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Database": "Data Source=backend.db"
  },
  "Jwt": {
    "Issuer": "BackendTemplate",
    "Audience": "BackendTemplate.Client",
    "LifetimeMinutes": 60
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
